const faqs = [
  {
    q: 'What counts as a connected mailbox?',
    a: 'Each connected email account (Google Workspace, Microsoft 365, or custom SMTP/IMAP mailbox) counts as one sending mailbox. Pro includes 50 connected mailboxes, Scale includes 250, and Enterprise provides unlimited connections. All mailboxes authenticate via OAuth 2.0 without password retention.',
  },
  {
    q: 'How does the monthly email sending quota work?',
    a: 'Pro includes 125,000 verified sends per month, while Scale includes 600,000 verified sends. Volume is automatically distributed across your connected mailbox pool with per-mailbox daily pacing and automated IP rotation to protect domain reputation and maximize inbox placement.',
  },
  {
    q: 'What are monthly plan credits used for?',
    a: 'Plan credits are allocated every billing month (7,500 for Pro, 35,000 for Scale, 100,000 for Enterprise) and are consumed by lead verification (1 credit per contact) and burst email volume beyond base quotas (0.2 credit per email). Add-on credits purchased separately roll over and never expire.',
  },
  {
    q: 'Do you charge per user or seat license?',
    a: 'No. SyncLead does not penalize team growth with seat tax. All plans include unlimited team member invitations with role-based permissions (Admin, Manager, Member). Additional client workspaces can be added for agency operations.',
  },
  {
    q: 'How does SyncLead safeguard domain deliverability?',
    a: 'We continuously monitor SPF, DKIM, DMARC, and MX records across all connected domains and alert you immediately upon any DNS drift. Our sending engine rotates across multi-IP pools and automatically throttles sending if bounce or complaint signals spike.',
  },
  {
    q: 'Can I upgrade or adjust plans as volume scales?',
    a: 'Yes. Upgrades take effect immediately with prorated billing calculated by Stripe. You can expand your sending pools, connect additional secondary domains, or step into dedicated agency controls whenever your outbound velocity demands it.',
  },
];
---

<PageLayout
  title="Pricing & Infrastructure Architecture — SyncLead"
  description="High-leverage outbound infrastructure pricing. Connect 50 to 250+ mailboxes, protect domain reputation with multi-IP pools, and eliminate seat tax forever."
>
  <!-- Hero Section -->
  <section class="pricing-hero">
    <div class="container">
      <div class="hero-content" data-reveal>
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span>HIGH-LEVERAGE INFRASTRUCTURE</span>
        </div>
        <h1 class="hero-title">
          Pricing built for serious<br />
          <em>outbound revenue engines.</em>
        </h1>
        <p class="hero-lead">
          Stop duct-taping seat licenses. Scale across 50 to 250+ connected mailboxes, continuous DNS monitoring, and multi-IP delivery pools with zero hidden caps.
        </p>

        <!-- Quick Jump Links -->
        <div class="quick-nav">
          <a href="#plans" class="q-btn">View Plans ↓</a>
          <a href="#matrix" class="q-btn">Feature Matrix ↓</a>
          <a href="#credits" class="q-btn">Credits & Utilization ↓</a>
          <a href="#faq" class="q-btn">Technical FAQ ↓</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Cards Grid -->
  <div id="plans">
    <PricingSection showHeader={false} />
  </div>

  <!-- Detailed Feature Comparison Matrix -->
  <section class="sec sec-matrix seam" id="matrix">
    <div class="container">
      <div class="sec-head text-center" data-reveal>
        <p class="eyebrow">Comprehensive Comparison</p>
        <h2 class="h2">Every specification. <em>Full transparency.</em></h2>
        <p class="lead">Compare infrastructure limits, automation capabilities, deliverability tooling, and agency controls.</p>
      </div>

      <div class="matrix-wrapper" data-reveal data-d="1">
        <!-- Floating Plan Sticky Header -->
        <div class="matrix-header">
          <div class="col-spec">SPECIFICATION</div>
          <div class="col-tier">
            <span class="t-name">Pro</span>
            <span class="t-price font-mono">$149<small>/mo</small></span>
          </div>
          <div class="col-tier highlight">
            <span class="t-badge">MOST POPULAR</span>
            <span class="t-name">Scale</span>
            <span class="t-price font-mono">$399<small>/mo</small></span>
          </div>
          <div class="col-tier">
            <span class="t-name">Enterprise</span>
            <span class="t-price font-mono">Custom</span>
          </div>
        </div>

        <!-- Category Groups -->
        {categories.map((cat) => (
          <div class="matrix-category">
            <div class="cat-title">
              <span>{cat.name}</span>
            </div>
            <div class="cat-rows">
              {cat.rows.map((row) => (
                <div class="matrix-row">
                  <div class="col-spec">
                    <strong class="feat-name">{row.feature}</strong>
                    <span class="feat-detail">{row.detail}</span>
                  </div>
                  <div class="col-tier">
                    {typeof row.pro === 'boolean' ? (
                      row.pro ? (
                        <span class="check-circle" aria-label="Included">
                          <svg viewBox="0 0 24 24"><path d="M4 12.5l5 5L20 6.5"/></svg>
                        </span>
                      ) : (
                        <span class="dash" aria-label="Not included">—</span>
                      )
                    ) : (
                      <span class="val-text font-mono">{row.pro}</span>
                    )}
                  </div>
                  <div class="col-tier highlight">
                    {typeof row.scale === 'boolean' ? (
                      row.scale ? (
                        <span class="check-circle check-sky" aria-label="Included">
                          <svg viewBox="0 0 24 24"><path d="M4 12.5l5 5L20 6.5"/></svg>
                        </span>
                      ) : (
                        <span class="dash" aria-label="Not included">—</span>
                      )
                    ) : (
                      <span class="val-text font-mono text-sky">{row.scale}</span>
                    )}
                  </div>
                  <div class="col-tier">
                    {typeof row.enterprise === 'boolean' ? (
                      row.enterprise ? (
                        <span class="check-circle" aria-label="Included">
                          <svg viewBox="0 0 24 24"><path d="M4 12.5l5 5L20 6.5"/></svg>
                        </span>
                      ) : (
                        <span class="dash" aria-label="Not included">—</span>
                      )
                    ) : (
                      <span class="val-text font-mono">{row.enterprise}</span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Plan Credits & Add-ons Section -->
  <section class="sec sec-credits seam" id="credits">
    <div class="container">
      <div class="sec-head" data-reveal>
        <p class="eyebrow">Credits & Utilization</p>
        <h2 class="h2">Deterministic credit economics. <em>Zero waste.</em></h2>
        <p class="lead">Every plan includes generous monthly operational credits. Add-on credits roll over and never expire.</p>
      </div>

      <div class="credits-grid" data-reveal data-d="1">
        <!-- Card 1: Credit Consumption Rules -->
        <div class="credit-card">
          <div class="c-head">
            <span class="c-icon">⚡</span>
            <h3>Credit Utilization Matrix</h3>
          </div>
          <p class="c-desc">Standard operations are mapped to predictable micro-credit units:</p>
          <ul class="c-list">
            <li>
              <div class="c-row">
                <span class="c-label">Lead Verification & Validation</span>
                <span class="c-val font-mono">1.0 Credit</span>
              </div>
              <span class="c-sub">Full syntax, MX ping, and disposable domain detection</span>
            </li>
            <li>
              <div class="c-row">
                <span class="c-label">Burst Email Sending (Beyond Plan Quota)</span>
                <span class="c-val font-mono">0.2 Credit</span>
              </div>
              <span class="c-sub">Continuous delivery without hard pauses when volume surges</span>
            </li>
            <li>
              <div class="c-row">
                <span class="c-label">AI Sequence Building & Intent Analysis</span>
                <span class="c-val font-mono">Included</span>
              </div>
              <span class="c-sub">Built into the platform runtime corpus</span>
            </li>
          </ul>
        </div>

        <!-- Card 2: Plan Allocation & Rollover -->
        <div class="credit-card">
          <div class="c-head">
            <span class="c-icon">🔄</span>
            <h3>Monthly Plan Allocation</h3>
          </div>
          <p class="c-desc">Fresh credit batches granted automatically at every billing reset:</p>
          <div class="alloc-bars">
            <div class="alloc-item">
              <div class="alloc-meta">
                <span>Pro Plan</span>
                <strong class="font-mono">7,500 Credits / mo</strong>
              </div>
              <div class="bar-track"><div class="bar-fill" style="width: 25%"></div></div>
            </div>
            <div class="alloc-item">
              <div class="alloc-meta">
                <span>Scale Plan (Most Popular)</span>
                <strong class="font-mono text-sky">35,000 Credits / mo</strong>
              </div>
              <div class="bar-track"><div class="bar-fill fill-sky" style="width: 60%"></div></div>
            </div>
            <div class="alloc-item">
              <div class="alloc-meta">
                <span>Enterprise Custom</span>
                <strong class="font-mono">100,000+ Credits / mo</strong>
              </div>
              <div class="bar-track"><div class="bar-fill" style="width: 100%"></div></div>
            </div>
          </div>
          <p class="alloc-note">
            ★ Add-on credit packages purchased outside the monthly quota are permanent and <strong>never expire</strong>.
          </p>
        </div>

        <!-- Card 3: Modular Add-Ons -->
        <div class="credit-card">
          <div class="c-head">
            <span class="c-icon">🛠</span>
            <h3>Modular Infrastructure Add-ons</h3>
          </div>
          <p class="c-desc">Tailor your workspace with dedicated support and client partitions:</p>
          <ul class="c-list">
            <li>
              <div class="c-row">
                <span class="c-label">Dedicated Support Assistant</span>
                <span class="c-val font-mono">$30 / mo</span>
              </div>
              <span class="c-sub">Assigned engineer for sequence QA and mailbox onboarding</span>
            </li>
            <li>
              <div class="c-row">
                <span class="c-label">Additional Agency Workspaces</span>
                <span class="c-val font-mono">+$39 / mo</span>
              </div>
              <span class="c-sub">Per additional isolated client tenant (Enterprise includes 5)</span>
            </li>
            <li>
              <div class="c-row">
                <span class="c-label">High-Throughput API Limits</span>
                <span class="c-val font-mono">Tiered</span>
              </div>
              <span class="c-sub">Burst rate limit expansions up to 1,000+ requests per minute</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical FAQ Accordion -->
  <section class="sec sec-faq seam" id="faq">
    <div class="container">
      <div class="sec-head text-center" data-reveal>
        <p class="eyebrow">Technical FAQ</p>
        <h2 class="h2">Frequently asked <em>questions.</em></h2>
        <p class="lead">Direct answers about deliverability, mailboxes, calendar recovery, and billing security.</p>
      </div>

      <div class="faq-grid" data-reveal data-d="1">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">
              <span>{faq.q}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Structured Data: FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a
      }
    }))
  })} />

  <!-- Bottom CTA -->
  <CTASection />
</PageLayout>

<style>
  /* Pricing Hero */
  .pricing-hero {
    position: relative;
    padding-top: clamp(140px, 18vh, 180px);
    padding-bottom: clamp(60px, 8vh, 90px);
    background: var(--bg-0);
    overflow: hidden;
  }
  .pricing-hero::before {
    content: '';
    position: absolute;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 900px;
    height: 500px;
    background: radial-gradient(circle, rgba(65, 200, 255, 0.08), transparent 70%);
    pointer-events: none;
  }

  .hero-content {
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(65, 200, 255, 0.08);
    border: 1px solid rgba(65, 200, 255, 0.25);
    border-radius: 999px;
    padding: 6px 16px;
    font: 600 10.5px var(--f-mono);
    color: var(--color-sky);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-sky);
    box-shadow: 0 0 8px var(--color-sky);
  }

  .hero-title {
    font: 800 clamp(38px, 5.5vw, 62px)/1.1 var(--f-ui);
    color: #fff;
    letter-spacing: -0.03em;
  }
  .hero-title em {
    font-style: italic;
    font-family: var(--f-serif);
    font-weight: 400;
    color: var(--color-sky);
    display: block;
    margin-top: 4px;
  }
  .hero-lead {
    font: 400 clamp(16px, 2vw, 19px)/1.6 var(--f-ui);
    color: var(--ink-2);
    max-width: 680px;
    margin: 20px auto 0;
  }

  /* Quick Navigation */
  .quick-nav {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 36px;
  }
  .q-btn {
    font: 500 12px var(--f-mono);
    color: var(--ink-3);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--line-2);
    padding: 7px 16px;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .q-btn:hover {
    color: #fff;
    border-color: rgba(65, 200, 255, 0.4);
    background: rgba(65, 200, 255, 0.08);
  }

  /* Feature Comparison Matrix */
  .sec-matrix {
    background: #060913;
    padding-top: 90px;
    padding-bottom: 100px;
  }
  .matrix-wrapper {
    max-width: 1140px;
    margin: 48px auto 0;
    background: rgba(9, 14, 28, 0.85);
