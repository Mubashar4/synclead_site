---
/**
 * FoundingTeams.astro — Founding teams offer section. Design system v2 (WD-032).
 * WD-016 framing: exclusive infrastructure, not beta. WD-031 lexicon.
 */
const cards = [
  {
    title: 'Direct line to the people building it',
    body: 'You talk to the team writing the code, not a support tier. You tell us what your outbound engine is missing, and we build it directly into the platform.',
  },
  {
    title: 'Locked founding price',
    body: 'Your rate is fixed for as long as you stay subscribed, including after public pricing rises.',
  },
  {
    title: 'Migration done with you',
    body: 'We help move your existing sequences, sending accounts and DNS setup across, on a call, at no cost.',
  },
];
---

<section class="sec sec-white" id="founding-teams">
  <div class="container">
    <div class="sec-head" data-reveal>
      <p class="eyebrow" style="display:flex;justify-content:center">Founding teams</p>
      <h2 class="h2">Let us rebuild your <em>outbound.</em></h2>
      <p class="lead" style="max-width:672px">We are exclusively onboarding serious outbound engines — from solo founders scaling their first campaigns to GTM teams replacing fractured stacks. Skip the support queues. You get a direct Slack channel with our engineering team, a white-glove migration of your current sequences, and your pricing locked in forever. If you treat outbound like a science, we are a fit.</p>
    </div>

    <div class="ft-grid">
      {cards.map((card, i) => (
        <div class="ft-card" data-reveal data-d={i > 0 ? i : undefined}>
          <span class="ft-ic">
            <svg viewBox="0 0 24 24"><path d="M4 12.5l5 5L20 6.5"/></svg>
          </span>
          <h3>{card.title}</h3>
          <p>{card.body}</p>
        </div>
      ))}
    </div>

    <div class="ft-cta" data-reveal>
      <a class="btn btn-dark btn-lg" href="mailto:contact@synclead.io?subject=Founding%20team%20spot">Claim a Founding Team Spot</a>
      <p class="sub">Tell us what your current stack looks like. If we are not the right fit to scale your volume, we will tell you directly on the call.</p>
    </div>
  </div>
</section>

<style>
  .ft-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 52px; }
  .ft-card {
    background: #fff; border: 1px solid var(--line-l); border-radius: 16px;
    padding: 30px 28px;
    box-shadow: var(--shadow-card);
    transition: transform 0.3s var(--ease), box-shadow 0.3s, border-color 0.3s;
  }
  .ft-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
    border-color: rgba(14, 134, 200, 0.4);
  }
  .ft-ic {
    width: 34px; height: 34px; border-radius: 50%;
    background: var(--color-sky); display: grid; place-items: center;
  }
  .ft-ic svg {
    width: 15px; height: 15px; stroke: #06121F; fill: none;
    stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round;
  }
  .ft-card h3 { font: 600 18.5px var(--f-ui); color: var(--ink-l); margin-top: 18px; letter-spacing: -0.015em; }
  .ft-card p { font: 400 15px/1.65 var(--f-ui); color: var(--ink-l-2); margin-top: 10px; }
  .ft-cta { margin-top: 52px; text-align: center; }
  .ft-cta .sub { font: 400 14.5px/1.6 var(--f-ui); color: var(--ink-l-3); margin-top: 18px; }

  @media (max-width: 1020px) { .ft-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) { .ft-grid { grid-template-columns: 1fr; } }
</style>
