---
/**
 * AnimatedCounter.astro — Counting number animation triggered by IntersectionObserver.
 * Spec: site-spec.md §6.5
 */
interface Props {
  value: number;
  format?: 'int' | 'percent' | 'suffix';
  suffix?: string;
  decimals?: number;
  label: string;
  class?: string;
}

const {
  value,
  format = 'int',
  suffix = '',
  decimals = 0,
  label,
  class: className = '',
} = Astro.props;

// Format the final display value
let formattedValue = value.toLocaleString('en-US', {
  minimumFractionDigits: decimals,
  maximumFractionDigits: decimals,
});

if (format === 'percent') {
  formattedValue = `${formattedValue}%`;
} else if (format === 'suffix') {
  formattedValue = `${formattedValue}\u2009${suffix}`;
}

const counterId = `counter-${Math.random().toString(36).slice(2, 9)}`;
---

<div class={className}>
  <span
    id={counterId}
    class="counter-value block"
    data-reveal
    data-counter-final={formattedValue}
    data-counter-raw={value.toString()}
    data-counter-format={format}
    data-counter-suffix={suffix}
    data-counter-decimals={decimals.toString()}
  >
    <noscript>{formattedValue}</noscript>
  </span>
  <p class="text-body-m text-white/60 mt-2">{label}</p>
</div>

<script define:vars={{ counterId }}>
  // Self-contained counter animation (spec exception: vanilla, idempotent)
  const el = document.getElementById(counterId);
  if (el) {
    const raw = parseFloat(el.dataset.counterRaw || '0');
    const fmt = el.dataset.counterFormat || 'int';
    const sfx = el.dataset.counterSuffix || '';
    const dec = parseInt(el.dataset.counterDecimals || '0', 10);
    const final = el.dataset.counterFinal || '0';
    const duration = 1200;

    // Check reduced motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      el.textContent = final;
    } else {
      // Wait for .is-revealed class (added by shared observer)
      const observer = new MutationObserver(() => {
        if (el.classList.contains('is-revealed')) {
          observer.disconnect();
          animate();
        }
      });
      observer.observe(el, { attributes: true, attributeFilter: ['class'] });

      // If already revealed
      if (el.classList.contains('is-revealed')) {
        observer.disconnect();
        animate();
      }
    }

    function animate() {
      const start = performance.now();
      function step(now) {
        const progress = Math.min((now - start) / duration, 1);
        // Ease out cubic
        const eased = 1 - Math.pow(1 - progress, 3);
        const current = Math.floor(eased * raw);
        let display = current.toLocaleString('en-US', {
          minimumFractionDigits: dec,
          maximumFractionDigits: dec,
        });
        if (fmt === 'percent') display = `${display}%`;
        else if (fmt === 'suffix') display = `${display}\u2009${sfx}`;
        el.textContent = display;
        if (progress < 1) requestAnimationFrame(step);
        else el.textContent = final;
      }
      requestAnimationFrame(step);
    }
  }
</script>
