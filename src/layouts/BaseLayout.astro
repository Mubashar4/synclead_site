---
/**
 * BaseLayout.astro — HTML shell, SEO/meta, font imports, global CSS, shared reveal script.
 * Spec: site-spec.md §4.1 · Design system v2 (WD-032)
 *
 * Fonts: Instrument Sans (UI), Instrument Serif (italic emphasis), JetBrains Mono (mono/labels)
 * Reveal: IntersectionObserver adds `.in` class to `[data-reveal]` elements (WD-011)
 */
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/instrument-sans/700.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, ogType = 'website', noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL.href} />

  <!-- Open Graph -->
  <meta property="og:site_name" content="SyncLead" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="SyncLead — cold outreach, deliverability and booking in one platform" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@syncleadio" />
  <meta name="twitter:creator" content="@syncleadio" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  <meta name="twitter:image:alt" content="SyncLead — cold outreach, deliverability and booking in one platform" />

  <!-- LLM / AI Context Discovery -->
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Knowledge Standard" />

  <!-- Favicon — real brand assets -->
  <link rel="icon" type="image/svg+xml" href="/logo-icon.svg" />
  <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
  <link rel="apple-touch-icon" href="/favicon-64.png" />

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />

  {noindex && <meta name="robots" content="noindex,nofollow" />}

  <!-- Structured Data: Organization -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "SyncLead",
    "legalName": "SYNCLEAD LTD",
    "url": "https://synclead.io",
    "logo": "https://synclead.io/logo-full-on-light.svg",
    "sameAs": [
      "https://www.linkedin.com/company/synclead",
      "https://x.com/syncleadio"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "contact@synclead.io",
      "contactType": "sales"
    }
  })} />

  <!-- Structured Data: WebSite -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "SyncLead",
    "alternateName": ["SyncLead.io", "SyncLead Platform"],
    "url": "https://synclead.io",
    "description": "Cold outreach deliverability protection and automated calendar scheduling in one platform."
  })} />

  <!-- Structured Data: SoftwareApplication -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "SyncLead",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "All (Web Browser / Cloud Platform)",
    "description": "Enterprise-grade cold email automation, continuous DNS deliverability checks, and native round-robin calendar booking.",
    "url": "https://synclead.io",
    "offers": [
      {
        "@type": "Offer",
        "name": "Pro Plan",
        "price": "149.00",
        "priceCurrency": "USD",
        "billingDuration": "P1M",
        "availability": "https://schema.org/InStock",
        "url": "https://synclead.io/pricing"
      },
      {
        "@type": "Offer",
        "name": "Scale Plan",
        "price": "399.00",
        "priceCurrency": "USD",
        "billingDuration": "P1M",
        "availability": "https://schema.org/InStock",
        "url": "https://synclead.io/pricing"
      }
    ]
  })} />
</head>
<body id="top">
  <a class="skip" href="#main">Skip to content</a>
  <slot />

  <!-- Shared reveal observer (WD-011) + nav scroll handler -->
  <script>
    (() => {
      'use strict';
      const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Reveal system
      const io = new IntersectionObserver((es) => {
        for (const e of es) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }
      }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });

      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Reduced motion: reveal everything immediately
      if (RM) {
        document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('in'));
      }
    })();
  </script>
</body>
</html>
